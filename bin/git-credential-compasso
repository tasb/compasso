#!/usr/bin/env bash
# Git's credential helper for a Compasso agent: git asks it for the password of the tracker's host,
# and it answers with the token of the account this checkout uses (bin/persona.sh account).
# persona.sh copies it to ${COMPASSO_HOME:-$HOME/.compasso}/bin, a path no plugin update moves, and
# sets it in the repository's own git configuration; it holds no secret and reads only that home.
#
#   git-credential-compasso get                  git's protocol -> username=, password=
#   git-credential-compasso token --repo R       the account's token -> stdout (bin/persona.sh env)
#
# The account's token: GitLab, the file <home>/accounts/<host>/<login> (mode 600, written by a person);
# GitHub, `gh auth token --user <login>` (gh holds the account). A checkout with no account gets no answer.
set -u
case "${1:-}" in -h|--help) sed -n '2,/^set -u/s/^# \{0,1\}//p' "$0"; exit 0 ;; esac   # the header above is the help

CMD="${1:-}"; shift || true
REPO="."
while [ $# -gt 0 ]; do case "$1" in --repo) REPO="$2"; shift 2 ;; *) shift ;; esac; done
HOME_DIR="${COMPASSO_HOME:-$HOME/.compasso}"

checkout_file() { # the persona file of the repository holding R (its worktrees share it)
  local r common
  r="$(cd "$1" 2>/dev/null && pwd -P)" || return 1
  common="$(git -C "$r" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  case "$common" in */.git) r="$(cd "${common%/.git}" && pwd -P)" ;; esac
  printf '%s' "$HOME_DIR/persona/$(printf '%s' "$r" | shasum -a 256 | cut -d' ' -f1)"
}
field() { sed -n "s/^$1=//p" "$FILE" 2>/dev/null | head -1; }
token() {
  case "$(field provider)" in
    gitlab) cat "$HOME_DIR/accounts/$(field host)/$(field account)" 2>/dev/null ;;
    github) gh auth token --hostname "$(field host)" --user "$(field account)" 2>/dev/null ;;
  esac
}

case "$CMD" in
  get)
    FILE="$(checkout_file .)" || exit 0
    [ -n "$(field account)" ] || exit 0
    # git asks only for the tracker's host: the helper is set under credential.https://<host>.helper
    t="$(token)"; [ -n "$t" ] || exit 0
    printf 'username=%s\npassword=%s\n' "$(field account)" "$t" ;;
  token)
    FILE="$(checkout_file "$REPO")" || exit 1
    [ -n "$(field account)" ] || exit 0
    t="$(token)"; [ -n "$t" ] || { echo "compasso: no token for $(field account) on $(field host)" >&2; exit 1; }
    printf '%s\n' "$t" ;;
  store|erase) exit 0 ;;   # the token lives where its owner put it; git never writes it
  *) exit 0 ;;
esac
