#!/usr/bin/env bash
# The path cron runs, which no plugin update moves: bin/cron.sh copies it to ${COMPASSO_HOME:-$HOME/.compasso}/bin.
# It starts bin/run.sh of the newest Compasso installed: Claude Code's plugin cache
# (<cache>/<marketplace>/compasso/<version>/, the cache ~/.claude/plugins/cache or $COMPASSO_PLUGIN_CACHE),
# else the Codex engine (<home>/engine, bin/install-codex.sh).
#
#   compasso-run lead|dev [run.sh's options]
#
# Exit: run.sh's | 1 no Compasso installed
set -u
case "${1:-}" in -h|--help) sed -n '2,/^set -u/s/^# \{0,1\}//p' "$0"; exit 0 ;; esac   # the header above is the help

CACHE="${COMPASSO_PLUGIN_CACHE:-$HOME/.claude/plugins/cache}"
HOME_DIR="${COMPASSO_HOME:-$HOME/.compasso}"
newer() { # a b: is version a newer than b, part by part as numbers
  local IFS=. a b i
  read -r -a a <<<"$1"; read -r -a b <<<"$2"
  for i in 0 1 2; do
    [ "${a[$i]:-0}" -gt "${b[$i]:-0}" ] 2>/dev/null && return 0
    [ "${a[$i]:-0}" -lt "${b[$i]:-0}" ] 2>/dev/null && return 1
  done
  return 1
}
root="" best=""
for f in "$CACHE"/*/compasso/*/.claude-plugin/plugin.json; do
  [ -f "$f" ] || continue
  v="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1)"
  [ -n "$v" ] || continue
  if [ -z "$best" ] || newer "$v" "$best"; then best="$v"; root="${f%/.claude-plugin/plugin.json}"; fi
done
[ -n "$root" ] || { [ -f "$HOME_DIR/engine/bin/run.sh" ] && root="$HOME_DIR/engine"; }
[ -n "$root" ] || { echo "compasso-run: no Compasso installed (Claude Code plugin or Codex engine)" >&2; exit 1; }
exec bash "$root/bin/run.sh" "$@"
